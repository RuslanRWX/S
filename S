#!/usr/bin/env python3
"""S — interactive SSH launcher from Ansible inventory."""

import json
import os
import shutil
import subprocess
import sys

DEFAULT_USER = "root"
DEFAULT_PORT = 22
CONFIG_DIR = os.path.expanduser("~/.S")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config")


# ── Config ────────────────────────────────────────────────────────────────────

def load_config():
    if not os.path.exists(CONFIG_FILE):
        return {}
    with open(CONFIG_FILE) as f:
        return json.load(f)


def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        json.dump(cfg, f, indent=2)


def cmd_config(args):
    name = None
    inventory = None
    i = 0
    while i < len(args):
        if args[i] == "--name" and i + 1 < len(args):
            name = args[i + 1]
            i += 2
        elif args[i] == "--inventory" and i + 1 < len(args):
            inventory = os.path.expanduser(args[i + 1])
            i += 2
        else:
            sys.exit(f"Unknown option: {args[i]}\nUsage: S config --name <name> --inventory <path>")

    if not name or not inventory:
        sys.exit("Usage: S config --name <name> --inventory <path>")

    cfg = load_config()
    envs = cfg.setdefault("environments", {})
    envs[name] = inventory
    if "default" not in cfg:
        cfg["default"] = name
        print(f"Environment '{name}' set as default.")
    save_config(cfg)
    print(f"Saved: '{name}' → {inventory}")


def cmd_list_env():
    cfg = load_config()
    envs = cfg.get("environments", {})
    if not envs:
        print("No environments configured.")
        print("Run: S config --name <name> --inventory <path>")
        return
    default = cfg.get("default", "")
    s_env = os.environ.get("S_ENV", "")
    print("Configured environments:\n")
    for name, path in envs.items():
        markers = []
        if name == default:
            markers.append("default")
        if s_env and name == s_env:
            markers.append("$S_ENV")
        tag = f"  [{', '.join(markers)}]" if markers else ""
        exists = "" if os.path.exists(path) else "  [NOT FOUND]"
        print(f"  {name}{tag}  →  {path}{exists}")
    print()


def resolve_inventory(env_name=None):
    """Return (inventory_path, env_name) or exit with a helpful message."""
    cfg = load_config()
    envs = cfg.get("environments", {})

    if not envs and not env_name:
        print("S is not configured yet.")
        print("Run: S config --name <name> --inventory <path>")
        sys.exit(1)

    # Priority: explicit arg > $S_ENV > config default
    if not env_name:
        env_name = os.environ.get("S_ENV") or cfg.get("default")

    if not env_name:
        # Fall back to first entry
        env_name = next(iter(envs))

    if env_name not in envs:
        available = ", ".join(envs) if envs else "(none)"
        sys.exit(
            f"Unknown environment '{env_name}'. Available: {available}\n"
            f"Add it with: S config --name {env_name} --inventory <path>"
        )

    return envs[env_name], env_name


# ── Inventory parsing ─────────────────────────────────────────────────────────

def load_hosts(path):
    try:
        import yaml
    except ImportError:
        sys.exit("PyYAML is required: pip install pyyaml")

    with open(path) as f:
        inv = yaml.safe_load(f)

    all_block = inv.get("all") or {}
    all_vars = (all_block.get("vars") or {})
    global_user = all_vars.get("ansible_user", DEFAULT_USER)

    seen = {}

    def process_group(name, data, inherited_vars=None):
        if not data:
            return
        gvars = dict(inherited_vars or {})
        gvars.update(data.get("vars") or {})

        for hostname, hvars in (data.get("hosts") or {}).items():
            hvars = hvars or {}
            ip = hvars.get("ansible_host", hostname)
            user = (hvars.get("ansible_ssh_user")
                    or gvars.get("ansible_user")
                    or global_user)
            port = int(hvars.get("ansible_ssh_port")
                       or gvars.get("ansible_ssh_port")
                       or DEFAULT_PORT)
            if hostname in seen:
                if name not in seen[hostname]["groups"]:
                    seen[hostname]["groups"].append(name)
            else:
                seen[hostname] = dict(
                    hostname=hostname, ip=str(ip),
                    user=str(user), port=port,
                    groups=[name],
                )

        for child, cdata in (data.get("children") or {}).items():
            process_group(child, cdata, gvars)

    for grp, gdata in inv.items():
        if grp == "all":
            for child, cdata in (gdata.get("children") or {}).items():
                process_group(child, cdata, all_vars)
        else:
            process_group(grp, gdata)

    return list(seen.values())


# ── Display / picking ─────────────────────────────────────────────────────────

def fmt_host(h, w_host, num):
    port_sfx = f":{h['port']}" if h["port"] != DEFAULT_PORT else ""
    user_sfx = f"  [{h['user']}]" if h["user"] != DEFAULT_USER else ""
    return f"  {h['hostname']:<{w_host}}  {h['ip']}{port_sfx}{user_sfx}  {num:>3}"


def pick_fzf(hosts, query):
    w_h = max(len(h["hostname"]) for h in hosts)
    index = {}
    lines = []
    for i, h in enumerate(hosts, 1):
        line = fmt_host(h, w_h, i)
        index[line] = h
        lines.append(line)
    fzf = subprocess.run(
        ["fzf", "--height=50%", "--reverse", "--query", query],
        input="\n".join(lines), capture_output=True, text=True,
    )
    if fzf.returncode != 0:
        return None
    return index.get(fzf.stdout.strip())


def pick_list(all_hosts, query):
    from collections import OrderedDict
    current_query = query
    while True:
        if current_query:
            q = current_query.lower()
            hosts = [h for h in all_hosts
                     if q in h["hostname"].lower()
                     or q in h["ip"]
                     or any(q in g.lower() for g in h["groups"])]
        else:
            hosts = all_hosts

        if not hosts:
            print(f"  No hosts match '{current_query}'")
            try:
                raw = input("Search: ").strip()
            except (KeyboardInterrupt, EOFError):
                return None
            if raw.lower() == "exit":
                return None
            if raw.lower() == "all":
                current_query = None
            else:
                current_query = raw or None
            continue

        if len(hosts) == 1:
            return hosts[0]

        w_h = max(len(h["hostname"]) for h in hosts)
        groups = OrderedDict()
        for h in hosts:
            groups.setdefault(h["groups"][0], []).append(h)

        numbered = []
        for grp, members in groups.items():
            print(f"\n[{grp}]")
            for h in members:
                i = len(numbered) + 1
                numbered.append(h)
                print(fmt_host(h, w_h, i))

        print()
        try:
            raw = input("Select [number or name]: ").strip()
        except (KeyboardInterrupt, EOFError):
            return None

        if not raw:
            return None

        if raw.lower() == "exit":
            return None

        if raw.lower() == "all":
            current_query = None
            continue

        try:
            idx = int(raw) - 1
            if 0 <= idx < len(numbered):
                return numbered[idx]
            continue
        except ValueError:
            pass

        starts = [h for h in numbered if h["hostname"].lower().startswith(raw.lower())]
        if len(starts) == 1:
            return starts[0]

        print(f"  Not found by ^{raw} — searching by *{raw}*")
        current_query = raw


def ssh_exec(h):
    cmd = ["ssh"]
    if h["port"] != DEFAULT_PORT:
        cmd += ["-p", str(h["port"])]
    cmd.append(f"{h['user']}@{h['ip']}")
    print(f"\n→ {' '.join(cmd)}\n")
    os.execvp("ssh", cmd)


# ── Entrypoint ────────────────────────────────────────────────────────────────

def run_ssh(env_name, query):
    inv_path, resolved_env = resolve_inventory(env_name)
    if not os.path.exists(inv_path):
        sys.exit(
            f"Inventory not found: {inv_path}\n"
            f"Update with: S config --name {resolved_env} --inventory <path>"
        )
    print(f"[{resolved_env}]  {inv_path}\n")
    hosts = load_hosts(inv_path)
    selected = pick_fzf(hosts, query) if shutil.which("fzf") else pick_list(hosts, query)
    if selected:
        ssh_exec(selected)


def print_usage():
    print(
        "Usage:\n"
        "  S [query]                               — SSH picker (default env)\n"
        "  S env <name> [query]                    — SSH picker for a named env\n"
        "  S config --name <name> --inventory <path>  — add/update an environment\n"
        "  S list env                              — list configured environments\n"
        "\n"
        "Environment variable:\n"
        "  S_ENV=<name>   override which environment 'S' uses by default\n"
    )


def main():
    args = sys.argv[1:]

    if not args:
        run_ssh(None, "")
        return

    if args[0] == "config":
        cmd_config(args[1:])
        return

    if args[0] == "list" and len(args) >= 2 and args[1] == "env":
        cmd_list_env()
        return

    if args[0] == "env":
        if len(args) < 2:
            sys.exit("Usage: S env <name> [query]")
        run_ssh(args[1], " ".join(args[2:]))
        return

    if args[0] in ("-h", "--help", "help"):
        print_usage()
        return

    # Treat all args as a search query for the default env
    run_ssh(None, " ".join(args))


if __name__ == "__main__":
    main()
